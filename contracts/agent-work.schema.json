{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent work contract 0.2.0 (draft)",
  "oneOf": [
    {
      "$ref": "#/$defs/role"
    },
    {
      "$ref": "#/$defs/task"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/catalog"
    }
  ],
  "$defs": {
    "role": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "0.3.0"
        },
        "kind": {
          "const": "role"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "completion_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "skill_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "model_policy_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "spawn",
              "model-selection",
              "tool-isolation",
              "workspace-isolation",
              "fresh-context"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "optional_capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "spawn",
              "model-selection",
              "tool-isolation",
              "workspace-isolation",
              "fresh-context"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "permission_ceiling": {
          "type": "array",
          "items": {
            "enum": [
              "read",
              "write",
              "execute",
              "network",
              "delegate"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "required_permissions": {
          "type": "array",
          "items": {
            "enum": [
              "read",
              "write",
              "execute",
              "network",
              "delegate"
            ]
          },
          "uniqueItems": true,
          "description": "Permission classes without which this role cannot discharge its responsibilities: a floor, where permission_ceiling is the bound, and a subset of it. Adapters map these classes onto runtime-specific tool identifiers; the contract never names tools."
        }
      },
      "required": [
        "contract_version",
        "kind",
        "id",
        "purpose",
        "responsibilities",
        "boundaries",
        "inputs",
        "outputs",
        "completion_criteria",
        "skill_refs",
        "model_policy_ref",
        "required_capabilities",
        "optional_capabilities",
        "permission_ceiling"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "0.3.0"
        },
        "kind": {
          "const": "task"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "role_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ref",
              "revision",
              "purpose"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "scope": {
          "type": "object",
          "properties": {
            "in": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "out": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "write_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "in",
            "out",
            "write_paths"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "description",
              "verification"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "context_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ref",
              "revision",
              "purpose"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "spawn",
              "model-selection",
              "tool-isolation",
              "workspace-isolation",
              "fresh-context"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "enum": [
              "read",
              "write",
              "execute",
              "network",
              "delegate"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "model_policy_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "max_delegation_depth": {
              "type": "integer",
              "minimum": 0
            },
            "max_parallel_agents": {
              "type": "integer",
              "minimum": 1
            },
            "max_model_escalations": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "max_attempts",
            "max_delegation_depth",
            "max_parallel_agents",
            "max_model_escalations"
          ],
          "additionalProperties": false
        },
        "workspace": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "baseline_revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ref",
            "baseline_revision"
          ],
          "additionalProperties": false
        },
        "handoff_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "dispatch_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "contract_version",
        "kind",
        "task_id",
        "role_id",
        "objective",
        "inputs",
        "scope",
        "dependencies",
        "acceptance_criteria",
        "context_refs",
        "required_capabilities",
        "permissions",
        "model_policy_ref",
        "limits",
        "workspace",
        "handoff_to",
        "dispatch_id",
        "attempt"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "0.3.0"
        },
        "kind": {
          "const": "result"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "completed",
            "partial",
            "blocked",
            "failed",
            "cancelled"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "enum": [
            "direct",
            "subagent",
            "sequential-role-pass"
          ]
        },
        "provenance": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "runtime_version": {
              "type": "string",
              "minLength": 1
            },
            "adapter": {
              "type": "string",
              "minLength": 1
            },
            "profile_revision": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "workspace_revision": {
              "type": "string",
              "minLength": 1
            },
            "delivered_skills": {
              "type": "array",
              "uniqueItems": true,
              "description": "What the adapter placed in, or made available to, the executing context. An adapter claim about delivery; never evidence that the instructions were relied upon. No field asserts reliance.",
              "items": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "method": {
                    "enum": [
                      "preload",
                      "reference"
                    ]
                  }
                },
                "required": [
                  "ref",
                  "sha256",
                  "method"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "runtime",
            "runtime_version",
            "adapter",
            "profile_revision",
            "model",
            "workspace_revision"
          ],
          "additionalProperties": false
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "unverified",
                  "blocked"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "criterion_id",
              "status",
              "evidence_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "kind": {
                "enum": [
                  "source",
                  "execution",
                  "observation",
                  "document"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "ref",
              "revision",
              "claim",
              "outcome"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
              },
              "change": {
                "enum": [
                  "added",
                  "modified",
                  "deleted",
                  "renamed"
                ]
              },
              "revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "change",
              "revision"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "type": "boolean"
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "description",
              "blocking",
              "next_action"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "handoff_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "dispatch_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "required": [
        "contract_version",
        "kind",
        "task_id",
        "attempt",
        "status",
        "summary",
        "mechanism",
        "provenance",
        "acceptance",
        "evidence",
        "changed_files",
        "unresolved",
        "handoff_to",
        "dispatch_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "acceptance": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "pass"
                    },
                    "evidence_ids": {
                      "minItems": 1
                    }
                  }
                }
              },
              "unresolved": {
                "items": {
                  "properties": {
                    "blocking": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "catalog": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "0.3.0"
        },
        "kind": {
          "const": "catalog"
        },
        "status": {
          "const": "draft"
        },
        "rule_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "role_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "model_policy_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "default_limits": {
          "type": "object",
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "max_delegation_depth": {
              "type": "integer",
              "minimum": 0
            },
            "max_parallel_agents": {
              "type": "integer",
              "minimum": 1
            },
            "max_model_escalations": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "max_attempts",
            "max_delegation_depth",
            "max_parallel_agents",
            "max_model_escalations"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "kind",
        "status",
        "rule_refs",
        "role_refs",
        "model_policy_refs",
        "default_limits"
      ],
      "additionalProperties": false
    }
  }
}
